# ==============================================================================
# StaffTrack HRMS — Frontend Environment Configuration Example
# Copy this file to .env and adjust variables for your local/production environment
# ==============================================================================

# Backend API Endpoint URL
# Local Development: http://localhost:5000/api
# Production: Set to your hosted backend URL (e.g., https://your-backend.railway.app/api)
REACT_APP_API_URL=http://localhost:5000/api

# Application Branding
REACT_APP_NAME=StaffTrack HRMS
