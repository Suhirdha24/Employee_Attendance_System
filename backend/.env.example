# ==============================================================================
# StaffTrack HRMS — Backend Environment Configuration Example
# Copy this file to .env and adjust variables for your local/production environment
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Connection URI
# Local MongoDB Server: mongodb://127.0.0.1:27017/attendanceDB
# MongoDB Atlas Cluster: mongodb+srv://<username>:<password>@cluster.mongodb.net/attendanceDB?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/attendanceDB

# JWT Authentication Secret Key (Generate a secure 64-character string for production)
JWT_SECRET=supersecretattendancejwtkey_2026_dev_env

# Allowed Client Origin (for CORS configuration)
CLIENT_URL=http://localhost:3000
