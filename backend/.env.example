# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/attendanceDB
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/attendanceDB?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/attendanceDB

# Backend Server Port
PORT=5000

# JSON Web Token Secret Key (Use a strong random string in production)
JWT_SECRET=supersecretattendancejwtkey_2026_dev_env
